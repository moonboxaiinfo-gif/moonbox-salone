# Browser-exposed Vite variables. These are public configuration, never secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_SUPER_ADMIN_HOST=

# Server-only Netlify variables. Never prefix these with VITE_.
# Required by Netlify functions that use the service-role client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Restrict cross-origin function requests to exact trusted origins (comma-separated).
ALLOWED_ORIGINS=

# Provider secrets are server-only and only required if their integrations are enabled.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Random server-only secret of at least 32 characters for IP-hashed review throttling.
RATE_LIMIT_HMAC_SECRET=
